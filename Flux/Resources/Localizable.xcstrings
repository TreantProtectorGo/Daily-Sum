          }
        }
      }
    },
    "%@ %@ - %@" : {
      "comment" : "A currency option in the settings, showing the currency symbol, code, and a localized name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
