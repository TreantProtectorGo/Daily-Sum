    },
    "%@%%" : {
      "comment" : "A text label showing the percentage of a total amount that a particular category represents. The argument is the percentage value, formatted to one decimal place.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A badge displaying a number and a label. The argument is the number, and the second is the label.",
      "isCommentAutoGenerated" : true
    },
    "%lld accounts" : {
      "comment" : "A label showing the number of bank accounts the user has. The argument is the count of accounts.",
      "isCommentAutoGenerated" : true
    },
    "%lld recent transactions" : {
      "comment" : "A text label below a balance that indicates how many recent transactions there are. The number inside the parentheses is replaced with the actual number of transactions.",
      "isCommentAutoGenerated" : true
    },
    "%lld%%" : {
      "comment" : "A text label displaying the percentage of the budget that has been spent. The argument is the percentage of the budget that has been spent.",
      "isCommentAutoGenerated" : true
    },
    "1 %@" : {
      "comment" : "A picker in the transaction entry sheet that lets the user select how many days before a recurring transaction's due date a reminder should be sent.",
      "isCommentAutoGenerated" : true
    },
    "1 %@ = %@" : {
      "comment" : "A text showing the exchange rate between two currencies. The first argument is the code of the first currency. The second argument is the formatted value of the exchange rate, formatted to two decimal places. The third argument is the code of the second currency.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 %1$@ = %2$@"
          }
        }
      }
    },
