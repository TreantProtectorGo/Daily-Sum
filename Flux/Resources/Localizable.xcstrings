    "%lld" : {
      "comment" : "A badge displaying a number and a label. The argument is the number, and the second is the label.",
      "isCommentAutoGenerated" : true
    },
    "%lld accounts" : {
      "comment" : "A label showing the number of bank accounts the user has. The argument is the count of accounts.",
      "isCommentAutoGenerated" : true
    },
    "%lld recent transactions" : {
      "comment" : "A text label below a balance that indicates how many recent transactions there are. The number inside the parentheses is replaced with the actual number of transactions.",
      "isCommentAutoGenerated" : true
    },
    "%lld%%" : {
      "comment" : "A text label displaying the percentage of the budget that has been spent. The argument is the percentage of the budget that has been spent.",
      "isCommentAutoGenerated" : true
    },
    "0" : {
      "comment" : "A text field for entering a monetary amount.",
      "isCommentAutoGenerated" : true
    },
